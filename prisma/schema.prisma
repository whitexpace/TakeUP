generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemCategory {
  ELECTRONICS
  BOOKS
  CLOTHING
  TOOLS
  HOME_APPLIANCES
  SPORTS_OUTDOORS
  MUSIC_AUDIO
  TOYS_GAMES
  FURNITURE
  VEHICLES_ACCESSORIES
  HEALTH_BEAUTY
  SCHOOL_SUPPLIES
  PET_SUPPLIES
  OTHER
}

enum ItemAvailabilityStatus {
  AVAILABLE
  RENTED
}

enum ItemStatus {
  AVAILABLE
  RENTED
  DEACTIVATED
  DELETED
}

enum RateOption {
  PER_HOUR
  PER_DAY
}

enum TransactionStatus {
  PENDING                  @map("pending")
  AWAITING_LENDER_APPROVAL @map("awaiting_lender_approval")
  CONFIRMED                @map("confirmed")
  PAID                     @map("paid")
  ONGOING                  @map("ongoing")
  RETURNED                 @map("returned")
  COMPLETED                @map("completed")
  CANCELLED                @map("cancelled")
  IN_DISPUTE               @map("in_dispute")
  APPEALED                 @map("appealed")
  REFUNDED                 @map("refunded")
  FAILED                   @map("failed")

  @@map("transaction_status_enum")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_DISPUTE
}

enum BookingPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  GCASH         @map("gcash")
  CARD          @map("card")
  BANK_TRANSFER @map("bank")
  WALLET        @map("wallet")
  CASH          @map("cash")

  @@map("payment_method_enum")
}

enum PaymentStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SUCCESS    @map("success")
  FAILED     @map("failed")
  REFUNDED   @map("refunded")

  @@map("payment_status_enum")
}

enum ActorRole {
  SYSTEM   @map("system")
  BORROWER @map("borrower")
  LENDER   @map("lender")
  ADMIN    @map("admin")

  @@map("actor_role_enum")
}

enum DisputeReason {
  LATE    @map("late")
  DAMAGED @map("damaged")
  LOST    @map("lost")

  @@map("dispute_reason_enum")
}

enum DisputeStatus {
  OPEN         @map("open")
  UNDER_REVIEW @map("under_review")
  RESOLVED     @map("resolved")
  REJECTED     @map("rejected")
  APPEALED     @map("appealed")

  @@map("dispute_status_enum")
}

enum AccountType {
  LENDER
  BORROWER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ItemRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum RequestOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model Item {
  id               String        @id @default(uuid())
  numericId        Int           @unique @default(autoincrement())
  name             String
  description      String?
  condition        ItemCondition
  status           ItemStatus    @default(AVAILABLE)
  rateOption       RateOption    @default(PER_DAY)
  createdAt        DateTime      @default(now())
  rentalFee        Int
  replacementCost  Int?
  freeToBorrow     Boolean
  whatItemOffers   String?
  whatIsIncluded   String?
  knownIssues      String?
  usageLimitations String?
  isTrending       Boolean       @default(false)
  viewCount        Int           @default(0)
  bookingCount     Int           @default(0)
  likeCount        Int           @default(0)
  rating           Float         @default(0)
  lenderId         String
  borrowerId       String?

  borrower           Borrower?            @relation(fields: [borrowerId], references: [userId], onDelete: SetNull)
  lender             Lender               @relation(fields: [lenderId], references: [userId], onDelete: Cascade)
  availability       ItemAvailability[]
  bookings           Booking[]
  categories         ItemCategoryOnItem[]
  images             ItemImage[]
  likes              Like[]
  requestOffers      RequestOffer[]
  tags               ItemTagOnItem[]
  transactionReviews TransactionReview[]
  transactions       RentalTransaction[]

  @@index([lenderId])
  @@index([borrowerId])
  @@index([numericId])
}

model Booking {
  id                 String               @id @default(uuid())
  itemId             String
  borrowerId         String
  lenderId           String
  startDate          DateTime
  endDate            DateTime
  status             BookingStatus        @default(PENDING)
  paymentStatus      BookingPaymentStatus @default(PENDING)
  requestedAt        DateTime             @default(now())
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  disputeOpenedAt    DateTime?
  paymentProcessedAt DateTime?
  cancellationReason String?
  paymentMethod      PaymentMethod
  platformCommission Int                  @default(0)
  totalFee           Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower Borrower @relation(fields: [borrowerId], references: [userId], onDelete: Cascade)
  lender   Lender   @relation(fields: [lenderId], references: [userId], onDelete: Cascade)

  @@index([borrowerId])
  @@index([createdAt])
  @@index([itemId])
  @@index([itemId, startDate, endDate])
  @@index([lenderId])
  @@index([paymentStatus])
  @@index([status])
}

model RentalTransaction {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  bookingId   String?           @unique @map("booking_id")
  borrowerId  String?           @map("borrower_user_id")
  lenderId    String?           @map("lender_user_id")
  itemId      String?           @map("item_id")
  startDate   DateTime?         @map("rental_start_at") @db.Timestamptz(6)
  endDate     DateTime?         @map("rental_end_at") @db.Timestamptz(6)
  rentalFee   Decimal           @default(0) @map("rental_fee") @db.Decimal(12, 2)
  platformFee Decimal           @default(0) @map("platform_fee") @db.Decimal(12, 2)
  lateFee     Decimal           @default(0) @map("late_fee") @db.Decimal(12, 2)
  damageFee   Decimal           @default(0) @map("damage_fee") @db.Decimal(12, 2)
  totalAmount Decimal?          @default(dbgenerated("(((rental_fee + platform_fee) + late_fee) + damage_fee)")) @map("total_amount_v2") @db.Decimal(12, 2)
  status      TransactionStatus @default(PENDING) @map("current_status")
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  borrower   User?                  @relation("transactions_borrower_user_idToUser", fields: [borrowerId], references: [id], onDelete: Restrict)
  lender     User?                  @relation("transactions_lender_user_idToUser", fields: [lenderId], references: [id], onDelete: Restrict)
  item       Item?                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  disputes   TransactionDispute[]
  payments   TransactionPayment[]
  reviews    TransactionReview[]
  statusLogs TransactionStatusLog[]

  @@index([borrowerId, status, createdAt(sort: Desc)], map: "idx_transactions_borrower_status")
  @@index([lenderId, status, createdAt(sort: Desc)], map: "idx_transactions_lender_status")
  @@index([status, createdAt(sort: Desc)], map: "idx_transactions_status_created")
  @@map("transactions")
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  path      String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, path])
  @@index([itemId])
  @@index([itemId, sortOrder])
  @@index([itemId, isPrimary])
}

model ItemAvailability {
  id        String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  itemId    String
  startDate DateTime
  endDate   DateTime
  status    ItemAvailabilityStatus
  createdAt DateTime               @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, startDate, endDate])
  @@index([itemId])
  @@index([itemId, status])
  @@index([startDate, endDate])
}

model ItemCategoryOnItem {
  itemId    String
  category  ItemCategory
  createdAt DateTime     @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, category])
  @@index([category])
}

model Tag {
  id    String          @id @default(uuid())
  name  String          @unique
  items ItemTagOnItem[]
}

model ItemTagOnItem {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

model User {
  id                           String                 @id @default(uuid())
  username                     String
  email                        String                 @unique
  firstName                    String
  middleName                   String?
  lastName                     String
  googleSub                    String                 @unique
  accountType                  AccountType
  status                       UserStatus
  points                       Int                    @default(0)
  admin                        Admin?
  borrower                     Borrower?
  lender                       Lender?
  likes                        Like[]
  transactionDisputesAdmin     TransactionDispute[]   @relation("transaction_disputes_admin_idToUser")
  transactionDisputesFiled     TransactionDispute[]   @relation("transaction_disputes_filed_by_user_idToUser")
  transactionPaymentsPayee     TransactionPayment[]   @relation("transaction_payments_payee_user_idToUser")
  transactionPaymentsPayer     TransactionPayment[]   @relation("transaction_payments_payer_user_idToUser")
  transactionReviewsReviewee   TransactionReview[]    @relation("transaction_reviews_reviewee_user_idToUser")
  transactionReviewsReviewer   TransactionReview[]    @relation("transaction_reviews_reviewer_user_idToUser")
  transactionStatusLogsChanged TransactionStatusLog[]
  borrowedTransactions         RentalTransaction[]    @relation("transactions_borrower_user_idToUser")
  lentTransactions             RentalTransaction[]    @relation("transactions_lender_user_idToUser")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Admin {
  userId      String @id
  role        String
  accessLevel Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lender {
  id           Int    @unique @default(autoincrement())
  userId       String @id
  lenderRating Int    @default(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  listedItem    Item[]
  requestOffers RequestOffer[]
}

model Borrower {
  id             Int    @unique @default(autoincrement())
  userId         String @id
  borrowStatus   String
  borrowerRating Int    @default(0)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  borrowedItems Item[]
  itemRequests  ItemRequest[]
}

model ItemRequest {
  id             Int               @id @default(autoincrement())
  borrowerID     Int
  itemNeeded     String
  requestedDates DateTime[]
  priceRange     Int[]
  description    String
  status         ItemRequestStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  borrower Borrower       @relation(fields: [borrowerID], references: [id], onDelete: Cascade)
  offers   RequestOffer[]

  @@index([borrowerID])
  @@index([status])
  @@index([createdAt])
}

model RequestOffer {
  id             Int                @id @default(autoincrement())
  lenderID       Int
  requestID      Int
  itemID         Int
  rentalFee      Int
  availability   Boolean
  condition      ItemCondition
  rentalTerms    String?
  status         RequestOfferStatus @default(PENDING)
  borrowerReadAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  item    Item        @relation(fields: [itemID], references: [numericId], onDelete: Restrict)
  lender  Lender      @relation(fields: [lenderID], references: [id], onDelete: Cascade)
  request ItemRequest @relation(fields: [requestID], references: [id], onDelete: Cascade)

  @@unique([lenderID, requestID])
  @@index([requestID])
  @@index([lenderID])
  @@index([itemID])
  @@index([status])
  @@index([borrowerReadAt])
}

model TransactionDispute {
  id            String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId String        @map("transaction_id")
  filedByUserId String        @map("filed_by_user_id")
  reason        DisputeReason
  description   String?
  claimedAmount Decimal       @default(0) @map("claimed_amount") @db.Decimal(12, 2)
  status        DisputeStatus @default(OPEN)
  adminId       String?       @map("admin_id")
  resolution    String?
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  admin       User?             @relation("transaction_disputes_admin_idToUser", fields: [adminId], references: [id])
  filedByUser User              @relation("transaction_disputes_filed_by_user_idToUser", fields: [filedByUserId], references: [id])
  transaction RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status, createdAt(sort: Desc)], map: "idx_disputes_txn_status")
  @@map("transaction_disputes")
}

model TransactionPayment {
  id               String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId    String        @map("transaction_id")
  payerUserId      String        @map("payer_user_id")
  payeeUserId      String        @map("payee_user_id")
  amount           Decimal       @db.Decimal(12, 2)
  feeAmount        Decimal       @default(0) @map("fee_amount") @db.Decimal(12, 2)
  method           PaymentMethod
  gatewayReference String?       @map("gateway_reference") @db.VarChar(100)
  status           PaymentStatus @default(PENDING)
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  payeeUser   User              @relation("transaction_payments_payee_user_idToUser", fields: [payeeUserId], references: [id])
  payerUser   User              @relation("transaction_payments_payer_user_idToUser", fields: [payerUserId], references: [id])
  transaction RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status, createdAt(sort: Desc)], map: "idx_payments_txn_status")
  @@map("transaction_payments")
}

model TransactionReview {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId  String   @map("transaction_id")
  reviewerUserId String   @map("reviewer_user_id")
  revieweeUserId String?  @map("reviewee_user_id")
  itemId         String?  @map("item_id")
  rating         Int      @db.SmallInt
  reviewText     String?  @map("review_text")
  isAnonymous    Boolean  @default(false) @map("is_anonymous")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item         Item?             @relation(fields: [itemId], references: [id])
  revieweeUser User?             @relation("transaction_reviews_reviewee_user_idToUser", fields: [revieweeUserId], references: [id])
  reviewerUser User              @relation("transaction_reviews_reviewer_user_idToUser", fields: [reviewerUserId], references: [id])
  transaction  RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, reviewerUserId], map: "transaction_reviews_transaction_reviewer_unique")
  @@index([revieweeUserId, createdAt(sort: Desc)], map: "idx_reviews_reviewee_created")
  @@map("transaction_reviews")
}

model TransactionStatusLog {
  id              String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId   String             @map("transaction_id")
  oldStatus       TransactionStatus? @map("old_status")
  newStatus       TransactionStatus  @map("new_status")
  changedByUserId String?            @map("changed_by_user_id")
  changedByRole   ActorRole          @map("changed_by_role")
  remarks         String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  changedByUser User?             @relation(fields: [changedByUserId], references: [id])
  transaction   RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt(sort: Desc)], map: "idx_status_logs_txn_created")
  @@map("transaction_status_logs")
}
