generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemCategory {
  ELECTRONICS
  BOOKS
  CLOTHING
  TOOLS
  HOME_APPLIANCES
  SPORTS_OUTDOORS
  MUSIC_AUDIO
  TOYS_GAMES
  FURNITURE
  VEHICLES_ACCESSORIES
  HEALTH_BEAUTY
  SCHOOL_SUPPLIES
  PET_SUPPLIES
  OTHER
}

enum ItemAvailabilityStatus {
  AVAILABLE
  RENTED
}

enum ItemStatus {
  AVAILABLE
  RENTED
  DEACTIVATED
  DELETED
}

enum RateOption {
  PER_HOUR
  PER_DAY
}

enum TransactionStatus {
  PENDING                  @map("pending")
  AWAITING_LENDER_APPROVAL @map("awaiting_lender_approval")
  CONFIRMED                @map("confirmed")
  PAID                     @map("paid")
  ONGOING                  @map("ongoing")
  RETURNED                 @map("returned")
  COMPLETED                @map("completed")
  CANCELLED                @map("cancelled")
  IN_DISPUTE               @map("in_dispute")
  APPEALED                 @map("appealed")
  REFUNDED                 @map("refunded")
  FAILED                   @map("failed")

  @@map("transaction_status_enum")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_DISPUTE
}

enum BookingPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  GCASH         @map("gcash")
  CARD          @map("card")
  BANK_TRANSFER @map("bank")
  WALLET        @map("wallet")
  CASH          @map("cash")

  @@map("payment_method_enum")
}

enum PaymentStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SUCCESS    @map("success")
  FAILED     @map("failed")
  REFUNDED   @map("refunded")

  @@map("payment_status_enum")
}

enum ActorRole {
  SYSTEM   @map("system")
  BORROWER @map("borrower")
  LENDER   @map("lender")
  ADMIN    @map("admin")

  @@map("actor_role_enum")
}

enum DisputeReason {
  LATE    @map("late")
  DAMAGED @map("damaged")
  LOST    @map("lost")

  @@map("dispute_reason_enum")
}

enum DisputeStatus {
  OPEN         @map("open")
  UNDER_REVIEW @map("under_review")
  RESOLVED     @map("resolved")
  REJECTED     @map("rejected")
  APPEALED     @map("appealed")

  @@map("dispute_status_enum")
}

enum PaymentMethod {
  gcash
  card
  bank
  wallet
  cash

  @@map("payment_method_enum")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_DISPUTE
}

enum BookingPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Item {
  id          String        @id @default(uuid())
  name        String
  description String?
  condition   ItemCondition
  status      ItemStatus    @default(AVAILABLE)
  rateOption  RateOption    @default(PER_DAY)
  createdAt   DateTime      @default(now())

  rentalFee       Int
  replacementCost Int?
  freeToBorrow    Boolean
  availability    ItemAvailability[]
  bookings        Booking[]
  transactions    RentalTransaction[]

  whatItemOffers   String?
  whatIsIncluded   String?
  knownIssues      String?
  usageLimitations String?
  thumbnailImage   String?
  photos           String[]
  isTrending       Boolean       @default(false)
  viewCount        Int           @default(0)
  bookingCount     Int           @default(0)
  likeCount        Int           @default(0)
  rating           Float         @default(0)
  lenderId         String
  borrowerId       String?

  images     ItemImage[]
  categories ItemCategoryOnItem[]
  tags       ItemTagOnItem[]
  likes      Like[]

  isTrending   Boolean @default(false)
  viewCount    Int     @default(0)
  bookingCount Int     @default(0)
  likeCount    Int     @default(0)
  rating       Float   @default(0)

  lenderId   String
  borrowerId String?

  lender   Lender    @relation(fields: [lenderId], references: [userId], onDelete: Cascade)
  borrower Borrower? @relation(fields: [borrowerId], references: [userId], onDelete: SetNull)

  @@index([lenderId])
  @@index([borrowerId])
  @@index([createdAt])
  @@index([isTrending])
  @@index([rateOption])
  @@index([rating])
  @@index([status])
}

model Booking {
  id                 String               @id @default(uuid())
  itemId             String
  borrowerId         String
  lenderId           String
  startDate          DateTime
  endDate            DateTime
  status             BookingStatus        @default(PENDING)
  paymentStatus      BookingPaymentStatus @default(PENDING)
  requestedAt        DateTime             @default(now())
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  disputeOpenedAt    DateTime?
  paymentProcessedAt DateTime?
  cancellationReason String?
  paymentMethod      PaymentMethod
  platformCommission Int                  @default(0)
  totalFee           Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower Borrower @relation(fields: [borrowerId], references: [userId], onDelete: Cascade)
  lender   Lender   @relation(fields: [lenderId], references: [userId], onDelete: Cascade)

  @@index([borrowerId])
  @@index([createdAt])
  @@index([itemId])
  @@index([itemId, startDate, endDate])
  @@index([lenderId])
  @@index([paymentStatus])
  @@index([status])
}

model RentalTransaction {
  id         String            @id @default(uuid())
  itemId     String
  borrowerId String
  lenderId   String
  startDate  DateTime
  endDate    DateTime
  status     TransactionStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower Borrower @relation(fields: [borrowerId], references: [userId], onDelete: Cascade)
  lender   Lender   @relation(fields: [lenderId], references: [userId], onDelete: Cascade)

  @@index([borrowerId])
  @@index([createdAt])
  @@index([itemId])
  @@index([lenderId])
  @@index([startDate])
  @@index([status])
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  path      String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, path])
  @@index([itemId])
  @@index([itemId, sortOrder])
  @@index([itemId, isPrimary])
}

model ItemAvailability {
  id        String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  itemId    String
  startDate DateTime
  endDate   DateTime
  status    ItemAvailabilityStatus

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, startDate, endDate])
  @@index([itemId])
  @@index([itemId, status])
  @@index([startDate, endDate])
}

model ItemCategoryOnItem {
  itemId    String
  category  ItemCategory
  createdAt DateTime     @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, category])
  @@index([category])
}

model Tag {
  id    String          @id @default(uuid())
  name  String          @unique
  items ItemTagOnItem[]
}

model ItemTagOnItem {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

model User {
  id          String      @id @default(uuid())
  username    String
  email       String      @unique
  firstName   String
  middleName  String?
  lastName    String
  googleSub   String      @unique
  accountType AccountType
  status      UserStatus
  points      Int         @default(0)

  admin                        Admin?
  borrower                     Borrower?
  lender                       Lender?
  likes                        Like[]
  transactionDisputesAdmin     TransactionDispute[]   @relation("transaction_disputes_admin_idToUser")
  transactionDisputesFiled     TransactionDispute[]   @relation("transaction_disputes_filed_by_user_idToUser")
  transactionPaymentsPayee     TransactionPayment[]   @relation("transaction_payments_payee_user_idToUser")
  transactionPaymentsPayer     TransactionPayment[]   @relation("transaction_payments_payer_user_idToUser")
  transactionReviewsReviewee   TransactionReview[]    @relation("transaction_reviews_reviewee_user_idToUser")
  transactionReviewsReviewer   TransactionReview[]    @relation("transaction_reviews_reviewer_user_idToUser")
  transactionStatusLogsChanged TransactionStatusLog[]
  borrowedTransactions         RentalTransaction[]    @relation("transactions_borrower_user_idToUser")
  lentTransactions             RentalTransaction[]    @relation("transactions_lender_user_idToUser")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Admin {
  userId      String @id
  role        String
  accessLevel Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lender {
  userId       String @id
  lenderRating Int    @default(0)

  lenderRating Int @default(0)

  listedItem Item[]
  bookings     Booking[]
  transactions RentalTransaction[]
}

model Borrower {
  userId         String @id
  borrowStatus   String
  borrowerRating Int    @default(0)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  borrowedItems Item[]
  bookings      Booking[]
  transactions  RentalTransaction[]
}

enum AccountType {
  LENDER
  BORROWER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}
