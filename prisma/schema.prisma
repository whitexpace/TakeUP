generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemCategory {
  ELECTRONICS
  BOOKS
  CLOTHING
  TOOLS
  HOME_APPLIANCES
  SPORTS_OUTDOORS
  MUSIC_AUDIO
  TOYS_GAMES
  FURNITURE
  VEHICLES_ACCESSORIES
  HEALTH_BEAUTY
  SCHOOL_SUPPLIES
  PET_SUPPLIES
  OTHER
}

enum ItemAvailabilityStatus {
  AVAILABLE
  RENTED
}

enum ItemStatus {
  AVAILABLE
  RENTED
  DEACTIVATED
  DELETED
}

enum RateOption {
  PER_HOUR
  PER_DAY
}

enum TransactionStatus {
  PENDING                  @map("pending")
  AWAITING_LENDER_APPROVAL @map("awaiting_lender_approval")
  CONFIRMED                @map("confirmed")
  PAID                     @map("paid")
  ONGOING                  @map("ongoing")
  RETURNED                 @map("returned")
  COMPLETED                @map("completed")
  CANCELLED                @map("cancelled")
  IN_DISPUTE               @map("in_dispute")
  APPEALED                 @map("appealed")
  REFUNDED                 @map("refunded")
  FAILED                   @map("failed")

  @@map("transaction_status_enum")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RETURNED
  CANCELLED
  COMPLETED
  IN_DISPUTE
}

enum ReturnStatus {
  NOT_RETURNED
  RETURNED
  EARLY_RETURNED
}

enum RefundStatus {
  NONE
  PENDING
  PROCESSED
  NOT_ELIGIBLE
  FAILED
}

enum RefundReason {
  EARLY_RETURN
}

enum BookingPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  GCASH         @map("gcash")
  CARD          @map("card")
  BANK_TRANSFER @map("bank")
  WALLET        @map("wallet")
  CASH          @map("cash")

  @@map("payment_method_enum")
}

enum PaymentStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SUCCESS    @map("success")
  FAILED     @map("failed")
  REFUNDED   @map("refunded")

  @@map("payment_status_enum")
}

enum ActorRole {
  SYSTEM   @map("system")
  BORROWER @map("borrower")
  LENDER   @map("lender")
  ADMIN    @map("admin")

  @@map("actor_role_enum")
}

enum DisputeStatus {
  SUBMITTED @map("under_review")
  OPEN      @map("open")
  REJECTED  @map("rejected")
  RESOLVED  @map("resolved")
  APPEALED  @map("appealed")
  CLOSED    @map("closed")

  @@map("dispute_status_enum")
}

enum DisputeOutcome {
  BORROWER_AT_FAULT
  LENDER_AT_FAULT
  SHARED_FAULT
  DISMISSED
  NO_FAULT
}

enum DisputeFinalDecision {
  APPROVED
  REJECTED
}

enum DisputeActionType {
  WARNING
  POINT_DEDUCTION
  SUSPENSION
  BAN
}

enum NotificationType {
  BOOKING_RETURN_REQUESTED
  DISPUTE_SUBMITTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  DISPUTE_REBUTTAL_SUBMITTED
}

enum AccountType {
  LENDER
  BORROWER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
  DEACTIVATED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTransactionType {
  TOP_UP
  PAYMENT
  REFUND
  ADJUSTMENT
  EARNING
}

enum WalletTransactionMethod {
  PSEUDO
  GCASH
  BANK
  MAYA
  SYSTEM
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  SUCCESS
  FAILED
  REVERSED
  PENDING
}

enum ItemRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum RequestOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ReviewType {
  ITEM_REVIEW
  LENDER_REVIEW
  BORROWER_REVIEW
}

enum RewardSourceType {
  TRANSACTION_COMPLETED
  REVIEW_SUBMITTED
  DISPUTE_RESOLUTION_ADJUSTMENT
  BOOST_REDEMPTION
  MANUAL_ADJUSTMENT
}

enum RewardRoleCategory {
  BORROWER
  LENDER
  GENERAL
}

enum RewardEventStatus {
  PENDING
  APPLIED
  REVERSED
  BLOCKED
}

enum ItemBoostType {
  STANDARD_24_HOUR
}

enum ItemBoostStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Item {
  id               String        @id @default(uuid())
  numericId        Int           @unique @default(autoincrement())
  name             String
  description      String?
  condition        ItemCondition
  status           ItemStatus    @default(AVAILABLE)
  rateOption       RateOption    @default(PER_DAY)
  createdAt        DateTime      @default(now())
  rentalFee        Int
  replacementCost  Int?
  freeToBorrow     Boolean
  whatItemOffers   String?
  whatIsIncluded   String?
  knownIssues      String?
  usageLimitations String?
  isTrending       Boolean       @default(false)
  viewCount        Int           @default(0)
  bookingCount     Int           @default(0)
  likeCount        Int           @default(0)
  rating           Float         @default(0)
  boostScore       Int           @default(0)
  boostExpiresAt   DateTime?
  lenderId         String
  borrowerId       String?

  borrower           Borrower?            @relation(fields: [borrowerId], references: [userId], onDelete: SetNull)
  lender             Lender               @relation(fields: [lenderId], references: [userId], onDelete: Cascade)
  availability       ItemAvailability[]
  bookings           Booking[]
  cartEntries        CartEntry[]
  categories         ItemCategoryOnItem[]
  images             ItemImage[]
  likes              Like[]
  boosts             ItemBoost[]
  requestOffers      RequestOffer[]
  tags               ItemTagOnItem[]
  transactionReviews TransactionReview[]
  transactions       RentalTransaction[]

  @@index([lenderId])
  @@index([borrowerId])
  @@index([numericId])
}

model Booking {
  id                 String               @id @default(uuid())
  itemId             String
  borrowerId         String
  lenderId           String
  startDate          DateTime
  endDate            DateTime
  status             BookingStatus        @default(PENDING)
  paymentStatus      BookingPaymentStatus @default(PENDING)
  requestedAt        DateTime             @default(now())
  confirmedAt        DateTime?
  returnedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  disputeOpenedAt    DateTime?
  paymentProcessedAt DateTime?
  cancellationReason String?
  paymentMethod      PaymentMethod
  platformCommission Int                  @default(0)
  totalFee           Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Early return and refund tracking
  returnStatus      ReturnStatus  @default(NOT_RETURNED)
  refundStatus      RefundStatus  @default(NONE)
  refundAmount      Int           @default(0)
  refundProcessedAt DateTime?
  refundReason      RefundReason?
  actualReturnedAt  DateTime?

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower Borrower @relation(fields: [borrowerId], references: [userId], onDelete: Cascade)
  lender   Lender   @relation(fields: [lenderId], references: [userId], onDelete: Cascade)

  @@index([borrowerId])
  @@index([createdAt])
  @@index([itemId])
  @@index([itemId, startDate, endDate])
  @@index([lenderId])
  @@index([paymentStatus])
  @@index([status])
  @@index([returnStatus])
  @@index([refundStatus])
}

model AppNotification {
  id              String           @id @default(uuid())
  recipientUserId String
  actorUserId     String?
  bookingId       String?
  type            NotificationType
  title           String
  body            String
  actionPath      String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  actorUser     User? @relation("app_notifications_actor_user_idToUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  recipientUser User  @relation("app_notifications_recipient_user_idToUser", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt(sort: Desc)])
  @@index([bookingId])
}

model RentalTransaction {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  bookingId   String?           @unique @map("booking_id")
  borrowerId  String?           @map("borrower_user_id")
  lenderId    String?           @map("lender_user_id")
  itemId      String?           @map("item_id")
  startDate   DateTime?         @map("rental_start_at") @db.Timestamptz(6)
  endDate     DateTime?         @map("rental_end_at") @db.Timestamptz(6)
  rentalFee   Decimal           @default(0) @map("rental_fee") @db.Decimal(12, 2)
  platformFee Decimal           @default(0) @map("platform_fee") @db.Decimal(12, 2)
  lateFee     Decimal           @default(0) @map("late_fee") @db.Decimal(12, 2)
  damageFee   Decimal           @default(0) @map("damage_fee") @db.Decimal(12, 2)
  totalAmount Decimal?          @default(dbgenerated("(((rental_fee + platform_fee) + late_fee) + damage_fee)")) @map("total_amount_v2") @db.Decimal(12, 2)
  status      TransactionStatus @default(PENDING) @map("current_status")
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  borrower     User?                    @relation("transactions_borrower_user_idToUser", fields: [borrowerId], references: [id], onDelete: Restrict)
  lender       User?                    @relation("transactions_lender_user_idToUser", fields: [lenderId], references: [id], onDelete: Restrict)
  item         Item?                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  conversation Conversation?
  disputes     TransactionDispute[]
  payments     TransactionPayment[]
  rewardEvents RewardEvent[]
  reviewDrafts TransactionReviewDraft[]
  reviews      TransactionReview[]
  statusLogs   TransactionStatusLog[]

  @@index([borrowerId, status, createdAt(sort: Desc)], map: "idx_transactions_borrower_status")
  @@index([lenderId, status, createdAt(sort: Desc)], map: "idx_transactions_lender_status")
  @@index([status, createdAt(sort: Desc)], map: "idx_transactions_status_created")
  @@map("transactions")
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  path      String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, path])
  @@index([itemId])
  @@index([itemId, sortOrder])
  @@index([itemId, isPrimary])
}

model ItemAvailability {
  id        String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  itemId    String
  startDate DateTime
  endDate   DateTime
  status    ItemAvailabilityStatus
  createdAt DateTime               @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, startDate, endDate])
  @@index([itemId])
  @@index([itemId, status])
  @@index([startDate, endDate])
}

model ItemCategoryOnItem {
  itemId    String
  category  ItemCategory
  createdAt DateTime     @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, category])
  @@index([category])
}

model Tag {
  id    String          @id @default(uuid())
  name  String          @unique
  items ItemTagOnItem[]
}

model ItemTagOnItem {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

model User {
  id                                String                     @id @default(uuid())
  username                          String
  email                             String                     @unique
  firstName                         String
  middleName                        String?
  lastName                          String
  googleSub                         String                     @unique
  createdAt                         DateTime                   @default(now())
  location                          String?
  avatarUrl                         String?
  bio                               String?
  pronouns                          String?
  accountType                       AccountType
  status                            UserStatus
  points                            Int                        @default(0)
  admin                             Admin?
  appNotificationsReceived          AppNotification[]          @relation("app_notifications_recipient_user_idToUser")
  appNotificationsSent              AppNotification[]          @relation("app_notifications_actor_user_idToUser")
  borrower                          Borrower?
  cartEntries                       CartEntry[]
  itemBoosts                        ItemBoost[]
  lender                            Lender?
  likes                             Like[]
  transactionDisputesAdmin          TransactionDispute[]       @relation("transaction_disputes_admin_idToUser")
  transactionDisputesFinalized      TransactionDispute[]       @relation("transaction_disputes_final_decision_by_user_idToUser")
  transactionDisputesFiled          TransactionDispute[]       @relation("transaction_disputes_filed_by_user_idToUser")
  transactionDisputesRebuttal       TransactionDispute[]       @relation("transaction_disputes_rebuttal_by_user_idToUser")
  transactionDisputeActionsApplied  TransactionDisputeAction[] @relation("transaction_dispute_actions_applied_by_user_idToUser")
  transactionDisputeActionsTargeted TransactionDisputeAction[] @relation("transaction_dispute_actions_target_user_idToUser")
  transactionPaymentsPayee          TransactionPayment[]       @relation("transaction_payments_payee_user_idToUser")
  transactionPaymentsPayer          TransactionPayment[]       @relation("transaction_payments_payer_user_idToUser")
  transactionReviewDraftsReviewer   TransactionReviewDraft[]   @relation("transaction_review_drafts_reviewer_user_idToUser")
  transactionReviewsReviewee        TransactionReview[]        @relation("transaction_reviews_reviewee_user_idToUser")
  transactionReviewsReviewer        TransactionReview[]        @relation("transaction_reviews_reviewer_user_idToUser")
  transactionStatusLogsChanged      TransactionStatusLog[]
  borrowedTransactions              RentalTransaction[]        @relation("transactions_borrower_user_idToUser")
  lentTransactions                  RentalTransaction[]        @relation("transactions_lender_user_idToUser")
  requestPosts                      RequestPost[]
  rewardEvents                      RewardEvent[]
  rewards                           UserReward?
  sentMessages                      Message[]
  wallet                            Wallet?
  walletTransactions                WalletTransaction[]
}

model Wallet {
  id        String       @id @default(uuid())
  userId    String       @unique @map("user_id")
  currency  String       @default("PHP")
  balance   Decimal      @default(0) @db.Decimal(12, 2)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  walletId          String                     @map("wallet_id")
  userId            String                     @map("user_id")
  type              WalletTransactionType
  method            WalletTransactionMethod
  direction         WalletTransactionDirection
  amount            Decimal                    @db.Decimal(12, 2)
  balanceBefore     Decimal                    @map("balance_before") @db.Decimal(12, 2)
  balanceAfter      Decimal                    @map("balance_after") @db.Decimal(12, 2)
  referenceCode     String                     @unique @map("reference_code")
  relatedEntityType String?                    @map("related_entity_type")
  relatedEntityId   String?                    @map("related_entity_id")
  status            WalletTransactionStatus    @default(SUCCESS)
  metadata          Json                       @default("{}")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([referenceCode])
  @@index([relatedEntityType, relatedEntityId])
  @@map("wallet_transactions")
}

model CartEntry {
  id         String   @id @default(uuid())
  borrowerId String
  itemId     String
  startAt    DateTime
  endAt      DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  borrower User @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([borrowerId, itemId, startAt, endAt])
  @@index([borrowerId, createdAt])
  @@index([itemId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Admin {
  userId      String @id
  role        String
  accessLevel Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lender {
  id           Int    @unique @default(autoincrement())
  userId       String @id
  lenderRating Float  @default(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  listedItem    Item[]
  requestOffers RequestOffer[]
}

model Borrower {
  id             Int    @unique @default(autoincrement())
  userId         String @id
  borrowStatus   String
  borrowerRating Float  @default(0)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  borrowedItems Item[]
  itemRequests  ItemRequest[]
}

model ItemRequest {
  id                Int               @id @default(autoincrement())
  borrowerID        Int
  itemNeeded        String
  referenceImageUrl String?
  requestedDates    DateTime[]
  priceRange        Int[]
  description       String
  status            ItemRequestStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  borrower Borrower       @relation(fields: [borrowerID], references: [id], onDelete: Cascade)
  offers   RequestOffer[]

  @@index([borrowerID])
  @@index([status])
  @@index([createdAt])
}

model RequestOffer {
  id             Int                @id @default(autoincrement())
  lenderID       Int
  requestID      Int
  itemID         Int
  rentalFee      Int
  availability   Boolean
  condition      ItemCondition
  rentalTerms    String?
  status         RequestOfferStatus @default(PENDING)
  borrowerReadAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  item    Item        @relation(fields: [itemID], references: [numericId], onDelete: Restrict)
  lender  Lender      @relation(fields: [lenderID], references: [id], onDelete: Cascade)
  request ItemRequest @relation(fields: [requestID], references: [id], onDelete: Cascade)

  @@unique([lenderID, requestID])
  @@index([requestID])
  @@index([lenderID])
  @@index([itemID])
  @@index([status])
  @@index([borrowerReadAt])
}

model TransactionDispute {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId       String                @map("transaction_id")
  raisedById          String                @map("filed_by_user_id")
  reason              String
  description         String?
  claimedAmount       Decimal               @default(0) @map("claimed_amount") @db.Decimal(12, 2)
  status              DisputeStatus         @default(SUBMITTED)
  reviewedById        String?               @map("admin_id")
  resolution          String?
  reviewedAt          DateTime?             @map("resolved_at") @db.Timestamptz(6)
  outcome             DisputeOutcome?
  finalDecision       DisputeFinalDecision? @map("final_decision")
  finalDecisionNotes  String?               @map("final_decision_notes")
  finalDecisionById   String?               @map("final_decided_by_user_id")
  finalDecisionAt     DateTime?             @map("final_decided_at") @db.Timestamptz(6)
  requiredActionCount Int                   @default(0) @map("required_action_count")
  closedAt            DateTime?             @map("closed_at") @db.Timestamptz(6)
  rebuttalById        String?               @map("rebuttal_by_user_id")
  rebuttalText        String?               @map("rebuttal_text")
  rebuttalNotes       String?               @map("rebuttal_notes")
  rebuttalSubmittedAt DateTime?             @map("rebuttal_submitted_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  actions         TransactionDisputeAction[]
  rebuttalBy      User?                      @relation("transaction_disputes_rebuttal_by_user_idToUser", fields: [rebuttalById], references: [id])
  finalDecisionBy User?                      @relation("transaction_disputes_final_decision_by_user_idToUser", fields: [finalDecisionById], references: [id])
  reviewedBy      User?                      @relation("transaction_disputes_admin_idToUser", fields: [reviewedById], references: [id])
  raisedBy        User                       @relation("transaction_disputes_filed_by_user_idToUser", fields: [raisedById], references: [id])
  transaction     RentalTransaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status, createdAt(sort: Desc)], map: "idx_disputes_txn_status")
  @@map("transaction_disputes")
}

model TransactionDisputeAction {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  disputeId    String            @map("dispute_id")
  type         DisputeActionType
  targetUserId String            @map("target_user_id")
  pointsDelta  Int?              @map("points_delta")
  note         String?
  appliedById  String            @map("applied_by_user_id")
  appliedAt    DateTime          @default(now()) @map("applied_at") @db.Timestamptz(6)

  appliedBy  User               @relation("transaction_dispute_actions_applied_by_user_idToUser", fields: [appliedById], references: [id], onDelete: Restrict)
  dispute    TransactionDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  targetUser User               @relation("transaction_dispute_actions_target_user_idToUser", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([disputeId, appliedAt(sort: Desc)], map: "idx_dispute_actions_dispute_applied")
  @@index([targetUserId, appliedAt(sort: Desc)], map: "idx_dispute_actions_target_applied")
  @@map("transaction_dispute_actions")
}

model TransactionPayment {
  id               String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId    String        @map("transaction_id")
  payerUserId      String        @map("payer_user_id")
  payeeUserId      String        @map("payee_user_id")
  amount           Decimal       @db.Decimal(12, 2)
  feeAmount        Decimal       @default(0) @map("fee_amount") @db.Decimal(12, 2)
  method           PaymentMethod
  gatewayReference String?       @map("gateway_reference") @db.VarChar(100)
  status           PaymentStatus @default(PENDING)
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  payeeUser   User              @relation("transaction_payments_payee_user_idToUser", fields: [payeeUserId], references: [id])
  payerUser   User              @relation("transaction_payments_payer_user_idToUser", fields: [payerUserId], references: [id])
  transaction RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status, createdAt(sort: Desc)], map: "idx_payments_txn_status")
  @@map("transaction_payments")
}

model TransactionReview {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId  String     @map("transaction_id")
  reviewerUserId String     @map("reviewer_user_id")
  reviewType     ReviewType @default(ITEM_REVIEW) @map("review_type")
  revieweeUserId String?    @map("reviewee_user_id")
  itemId         String?    @map("item_id")
  rating         Int        @db.SmallInt
  reviewText     String     @map("review_text")
  images         String[]   @default([])
  isAnonymous    Boolean    @default(false) @map("is_anonymous")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  item         Item?             @relation(fields: [itemId], references: [id])
  rewardEvents RewardEvent[]
  revieweeUser User?             @relation("transaction_reviews_reviewee_user_idToUser", fields: [revieweeUserId], references: [id])
  reviewerUser User              @relation("transaction_reviews_reviewer_user_idToUser", fields: [reviewerUserId], references: [id])
  transaction  RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, reviewerUserId, reviewType], map: "transaction_reviews_transaction_reviewer_type_unique")
  @@index([revieweeUserId, createdAt(sort: Desc)], map: "idx_reviews_reviewee_created")
  @@map("transaction_reviews")
}

model TransactionReviewDraft {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId  String     @map("transaction_id")
  reviewerUserId String     @map("reviewer_user_id")
  reviewType     ReviewType @default(ITEM_REVIEW) @map("review_type")
  rating         Int        @default(5) @db.SmallInt
  reviewText     String     @default("") @map("review_text")
  images         String[]   @default([])
  isAnonymous    Boolean    @default(false) @map("is_anonymous")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviewerUser User              @relation("transaction_review_drafts_reviewer_user_idToUser", fields: [reviewerUserId], references: [id])
  transaction  RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, reviewerUserId, reviewType], map: "transaction_review_drafts_transaction_reviewer_type_unique")
  @@index([reviewerUserId, updatedAt(sort: Desc)], map: "idx_review_drafts_reviewer_updated")
  @@map("transaction_review_drafts")
}

model TransactionStatusLog {
  id              String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId   String             @map("transaction_id")
  oldStatus       TransactionStatus? @map("old_status")
  newStatus       TransactionStatus  @map("new_status")
  changedByUserId String?            @map("changed_by_user_id")
  changedByRole   ActorRole          @map("changed_by_role")
  remarks         String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  changedByUser User?             @relation(fields: [changedByUserId], references: [id])
  transaction   RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt(sort: Desc)], map: "idx_status_logs_txn_created")
  @@map("transaction_status_logs")
}

model UserReward {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String   @unique @map("user_id")
  availablePoints   Int      @default(0) @map("available_points")
  totalPointsEarned Int      @default(0) @map("total_points_earned")
  borrowerPoints    Int      @default(0) @map("borrower_points")
  lenderPoints      Int      @default(0) @map("lender_points")
  pendingPoints     Int      @default(0) @map("pending_points")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availablePoints])
  @@index([borrowerPoints])
  @@index([lenderPoints])
  @@map("user_rewards")
}

model RewardEvent {
  id             String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String             @map("user_id")
  transactionId  String?            @map("transaction_id")
  reviewId       String?            @map("review_id")
  itemBoostId    String?            @map("item_boost_id")
  idempotencyKey String             @unique @map("idempotency_key")
  sourceType     RewardSourceType   @map("source_type")
  roleCategory   RewardRoleCategory @default(GENERAL) @map("role_category")
  pointsDelta    Int                @map("points_delta")
  status         RewardEventStatus  @default(PENDING)
  metadata       Json               @default("{}")
  appliedAt      DateTime?          @map("applied_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  itemBoost   ItemBoost?         @relation(fields: [itemBoostId], references: [id], onDelete: SetNull)
  review      TransactionReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  transaction RentalTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([transactionId, status])
  @@index([reviewId])
  @@index([itemBoostId])
  @@map("reward_events")
}

model ItemBoost {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  itemId      String          @map("item_id")
  userId      String          @map("user_id")
  pointsSpent Int             @map("points_spent")
  boostType   ItemBoostType   @map("boost_type")
  boostScore  Int             @map("boost_score")
  status      ItemBoostStatus @default(ACTIVE)
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(6)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  rewardEvents RewardEvent[]
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId, status, expiresAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("item_boosts")
}

model RequestPost {
  id             String   @id @default(uuid())
  requesterId    String
  itemNeeded     String
  description    String
  requestedFrom  DateTime
  requestedTo    DateTime
  minTargetPrice Int
  maxTargetPrice Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([requestedTo])
  @@index([createdAt])
}

model AccountDeletionAuditLog {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  deletedUserId    String   @map("deleted_user_id")
  deletedUserEmail String?  @map("deleted_user_email")
  deletedUsername  String?  @map("deleted_username")
  deletedAt        DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)
  details          Json     @default("{}")

  @@index([deletedUserId])
  @@index([deletedAt(sort: Desc)])
  @@map("account_deletion_audit_logs")
}

model Conversation {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  transactionId String   @unique @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction RentalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([transactionId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String    @map("conversation_id")
  senderUserId   String    @map("sender_user_id")
  body           String
  imageUrl       String?   @map("image_url")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
  @@index([senderUserId])
  @@map("messages")
}
