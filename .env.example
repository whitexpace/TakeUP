# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NUXT_PUBLIC_SUPABASE_ITEM_IMAGE_BUCKET=item-images
NUXT_PUBLIC_SUPABASE_USER_AVATAR_BUCKET=user-avatars

# Prisma
# Use the Supabase pooler URL for Prisma Client queries (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Use the direct database URL for Prisma migrations (port 5432).
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Auth
GOOGLE_CLIENT_ID=
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
JWT_SECRET=
# Optional: enables local Supabase JWT verification (faster session bridge).
# Find at Supabase Dashboard → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Payments
PLATFORM_COMMISSION_RATE_PERCENT=5
